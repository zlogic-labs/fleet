# build output
/bin/
/dist/
*.exe
*.test
*.out
coverage.*

# Local development state: the control plane's default object store when
# scripts/dev.sh is used, and a stray fleet-data/ from running the binary
# directly without --data.
/.dev/
fleet-data/

# The console bundle is embedded by the Go build, not committed. Only the
# directory marker is tracked, so a fresh clone still compiles; `make web`
# stages the real output here.
/web/node_modules/
/web/dist/
/core/internal/gateway/webui/dist/*
!/core/internal/gateway/webui/dist/.gitkeep

# local config / secrets
.env
.env.local
/config/local.yaml
*.local.yaml

# editors
.idea/
.vscode/
*.swp
.DS_Store

# tool caches
.zlogic/

# Headless Chrome profile used for console screenshots.
/.chrome-tmp/

# Playwright MCP scratch
/.playwright-mcp/
